tel 1.0

# The test assembly (`./mill lira.test.assembly`), whose suites fume discovers from the jar's
# META-INF/services/probably.Suite index (written by the beneficence compiler plugin, which the
# `test` module enables for exactly this). Relative entries resolve against the invocation
# directory, so run fume from the repository root (`make test`).
classpath out/lira/test/assembly.dest/out.jar
