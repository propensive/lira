tel 1.0

# Flair checks lira's Scala sources: everything under src/, against Consequent Style, with the
# licence header every file begins with (etc/header.txt, the LIRA banner). `make check` runs the
# profile; CI does not, since findings are warnings and the count is not yet zero.

rule cast
  invokes asInstanceOf
  invokes isInstanceOf
  message  Casts bypass the type checker; prefer a pattern match

rule imperative
  uses var
  uses while
  uses null
  uses return

profile default
  source src/**/*.scala

  # The `-language` features the build compiles with, so flair parses the sources exactly as the
  # build does. Kept in step with `settings.scalaOptions` in build.mill — including capture and
  # separation checking, which lira compiles with and tel does not.
  language implicitConversions
  language experimental.modularity
  language experimental.dependent
  language experimental.relaxedLambdaSyntax
  language experimental.genericNumberLiterals
  language experimental.into
  language experimental.erasedDefinitions
  language experimental.saferExceptions
  language experimental.strictEqualityPatternMatching
  language experimental.subCases
  language experimental.multiSpreads
  language experimental.captureChecking
  language experimental.separationChecking

  style consequent
    header etc/header.txt
    columns 100
    interpolator m
    interpolator e

  enforce cast
