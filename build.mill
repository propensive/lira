//| mill-version: 1.1.5
//| mill-jvm-version: temurin:25
//| mill-jvm-opts: ["-Xss16m", "-XX:NonProfiledCodeHeapSize=250m", "-XX:ReservedCodeCacheSize=500m"]
//| mvnDeps: ["dev.propensive:crux-mill:0.1.1"]

package build

import mill.*
import scalalib.*
// `PomSettings`, `License`, `Developer`, `VersionControl`, `PublishModule` — the Maven publishing
// vocabulary, imported exactly as the Soundness build does (`scalalib.publish.*`).
import publish.*
// crux (propensive/crux): the pinned releases on GitHub, read directly as Coursier repositories.
import crux.*

object settings:
  // The compiler is the propensive Scala fork, Proscala, at this version: pinned in `deps` below
  // like the libraries and resolved from its GitHub release by crux, which also forces every
  // `org.scala-lang` artifact to it, since the pinned libraries name the release each was built
  // with. The fork stays TASTy-compatible across its patch releases, which is what every such
  // pin assumes.
  val scalaVersion = "3.10.0-pro-1.0.2"

  // This build's version. A release's version is declared once, by its tag: the release
  // (release.sh in propensive/.github) and a snapshot (snapshot.sh) both name it in
  // `LIRA_RELEASE_VERSION`. Any other build is the version after the latest release reachable
  // from HEAD — its patch version plus one, which sorts after that release and before whichever
  // follows it — or `0.0.1` where no release tag is reachable, as in CI's shallow checkout.
  // Called from `Task.Input`s, so the environment and the tags are read on every invocation.
  def version(env: Map[String, String]): String =
    env.get("LIRA_RELEASE_VERSION").filter(_.nonEmpty).getOrElse(nextVersion)

  def nextVersion: String =
    val root = mill.api.BuildCtx.workspaceRoot

    val latest: Option[String] =
      scala.util.Try:
        os.proc("git", "describe", "--tags", "--abbrev=0", "--match", "[0-9]*.[0-9]*.[0-9]*")
        . call(cwd = root, stderr = os.Pipe).out.text().trim
      . toOption

    def numeric(part: String): Boolean = part.nonEmpty && part.forall(_.isDigit)

    latest.collect:
      case s"$major.$minor.$patch" if Seq(major, minor, patch).forall(numeric) =>
        s"$major.$minor.${patch.toInt + 1}"
    . getOrElse("0.0.1")

  val scalaOptions = Seq(
    // The fork's opt-in behaviours, enabled by name, exactly as the Soundness build enables them —
    // lira compiles Soundness idioms from Soundness's own TASTy, so it needs the same repairs.
    "-Zalias-captures",
    "-Zdiagnostic-givens",
    "-Zgiven-prefixes",
    "-Zinline-source-maps",
    "-Zopaque-mutability",
    "-Zpure-iarrays",
    "-Zfrozen-pure",
    "-Zretains-bounds",
    "-Zretains-skolems",
    "-Zspreadable-varargs",
    "-Zunboxed-pure-types",
    "-Zunion-captures",
    "-experimental",
    "-new-syntax",
    "-feature",
    "-preview",
    "-deprecation",
    "-Wunused:imports",
    "-Wimplausible-patterns",
    "-Xmax-inlines", "32",
    "-Yno-flexible-types",
    "-Yexplicit-nulls",
    "-Ycheck-all-patmat",
    "-language:experimental.modularity",
    "-language:experimental.dependent",
    "-language:experimental.relaxedLambdaSyntax",
    "-language:experimental.genericNumberLiterals",
    "-language:experimental.into",
    "-language:experimental.erasedDefinitions",
    "-language:implicitConversions",
    "-language:experimental.saferExceptions",
    "-language:experimental.strictEqualityPatternMatching",
    "-language:experimental.subCases",
    "-language:experimental.multiSpreads",
    // Capture- and separation-checked, as fume and flame are and tel is not: lira's sources were
    // written for these flags from the start (each subsumes the corresponding per-file language
    // import). The format modules moved from Soundness are the exception, for now: see
    // `uncheckedOptions` below.
    "-Ycc-new",
    "-language:experimental.captureChecking",
    "-language:experimental.separationChecking")

  // The options of the LIRA library modules that Soundness compiled without capture checking
  // (`reliquary`, and the TASTy and anthology adapters), carried over unchanged when they moved
  // here from Soundness (its roadmap item dist-10). Checking them is further work, not part of the
  // move.
  val uncheckedOptions = scalaOptions.filterNot(Set(
    "-Ycc-new",
    "-language:experimental.captureChecking",
    "-language:experimental.separationChecking"))

  // The tool's sources are written for the proscenium predef (the Soundness house predef), so this
  // standalone build replicates `-Yno-predef -Yimports:…`, exactly as tel, fume and flame do.
  // `scala` is deliberately NOT imported (Soundness #1693): the blessed collections are
  // proscenium's opaque `List`/`Set`/`Map`/`Array`, and naming both packages would make every such
  // reference ambiguous. Stdlib collections must announce themselves with an explicit
  // `scala.`-qualified name or import, and cross the boundary through `proscenium.compat`.
  val predef = Seq("-Yno-predef", "-Yimports:java.lang,proscenium")

  // Soundness publishes COMPONENTS again (Soundness #1929): each tagged version is a GitHub release
  // whose assets are the individual component jars, and the bundles — including the
  // `dev.propensive:soundness-{cli,tool}` aggregates this build used to depend on — are no longer
  // published. Every released jar embeds its own POM and ivy.xml (`META-INF/maven/…`), and
  // `make sync-deps` installs the pinned release into `~/.ivy2/local`, from which coursier resolves
  // these coordinates with no repository configuration. Component jars carry no `_3` suffix, hence
  // the single-colon `mvn"…"`.
  //
  // This list names TOP-LEVEL components only: each jar's embedded POM names its own dependencies,
  // so the rest of the surface `import soundness.*` touches arrives transitively.
  //
  // The LIRA format itself (`src/format` and the modules beside it) is no longer here: it moved
  // from Soundness, where it was `reliquary` and the `lira` adapter components, into this
  // repository's own modules.
  //
  // Note what is absent: Pyrocosm. lira is not a Pyrocosm application — nothing here compiles
  // against pyrocosm-model or its frontends. See etc/refs.
  def soundnessDeps(soundness: String) = Seq(
    mvn"dev.propensive:aviation-core:$soundness",           // the daily upgrade check
    mvn"dev.propensive:burdock-core:$soundness",            // externalize + the repackager
    mvn"dev.propensive:dendrology-tree:$soundness",          // the `--tree` renderings
    mvn"dev.propensive:digression-ansi:$soundness",          // stack-trace diagnostics
    mvn"dev.propensive:escapade-io:$soundness",              // Teletype <-> Stdio writables
    mvn"dev.propensive:escritoire-core:$soundness",          // the listing tables
    mvn"dev.propensive:ethereal-core:$soundness",            // the resident daemon
    mvn"dev.propensive:eucalyptus-core:$soundness",          // logging.silentLogging
    mvn"dev.propensive:exoskeleton-completions:$soundness",  // cli + tab-completion
    mvn"dev.propensive:exoskeleton-manpage:$soundness",      // `lira install`'s manpage
    mvn"dev.propensive:gastronomy-core:$soundness",          // the upgrade's digest check
    mvn"dev.propensive:galilei-jvm:$soundness",              // the filesystem
    mvn"dev.propensive:hieroglyph-core:$soundness",          // charEncoders/charDecoders
    mvn"dev.propensive:iridescence-core:$soundness",         // the palette
    mvn"dev.propensive:monotonous-core:$soundness",          // alphabets.hexLowerCase
    mvn"dev.propensive:parasite-core:$soundness",            // threading.platformThreading
    mvn"dev.propensive:stratiform-core:$soundness",          // TEL rendering and BinTEL
    mvn"dev.propensive:telekinesis-core:$soundness",         // fetching the upgrade manifest
    mvn"dev.propensive:telekinesis-jvm:$soundness",          // httpBackends.javaNetHttp
    mvn"dev.propensive:urticose-core:$soundness")            // HttpUrl

  // The `lira.tool` contract is built on anthology's types (fury.md §6).
  def anthologyDeps(soundness: String) = Seq(
    mvn"dev.propensive:anthology-core:$soundness",           // Format, Universe, Edge, Toolchain
    mvn"dev.propensive:anthology-scala:$soundness")          // Scalac and its driver

  // The test module's extra surface: a `Suite` and the BinTEL event stream a host reads.
  def testDeps(soundness: String) = soundnessDeps(soundness) ++ Seq(
    mvn"dev.propensive:probably-cli:$soundness",
    mvn"dev.propensive:probably-events:$soundness")

// The propensive libraries this build depends on, pinned in etc/refs (the format, the snapshot flow
// and the shared scripts are documented in propensive/.github): each is a release `X.Y.Z`, or a
// snapshot `X.Y.Z-<12 hex>` of an unreleased upstream build, published there by `make snapshot`.
// crux resolves each — and, transitively, what each was built against — from its GitHub release;
// nothing is installed locally. The Proscala pin is declared here rather than in etc/refs, which
// deps.py (propensive/.github) also reads and which does not yet know the form of a Proscala
// version. The file is read as a source, so editing it invalidates every resolution.
object deps extends CruxModule:
  def refsFiles = Task.Sources(mill.api.BuildCtx.workspaceRoot / "etc" / "refs")
  def declared = Seq(Pin("propensive/proscala", settings.scalaVersion))

  def soundness: T[String] = Task(version("soundness")())

// A module compiled with the pinned fork, against the pinned libraries.
trait Fork extends CruxScalaModule:
  def crux = deps

trait Project extends Module:
  def moduleDir = super.moduleDir / os.up / "src"

// Dependencies are typed `PublishModule*` (as in the Soundness build) so that `moduleDeps` can
// return `Seq[PublishModule]` — the type `SonatypeCentralPublishModule` requires of the modules that
// mix in `Publishing`. This costs the unpublished modules (`launcher`, `test`) nothing.
trait Component(dependencies: PublishModule*) extends Fork:
  override def scalacOptions = settings.scalaOptions ++ settings.predef
  def moduleId: String = moduleDir.last
  def moduleDeps: Seq[PublishModule] = dependencies
  def sources = Task.Sources(moduleDir)

  // The beneficence plugin writes `META-INF/givens/<typeclass>` and `META-INF/services/probably.Suite`
  // into every module that contributes an entry, so each is a *fragment* of a build-wide index rather
  // than a whole file. Mill's default assembly rules are last-one-wins, which silently truncates
  // them: with Soundness arriving as a few dozen component jars that collide on those entries, the
  // givens index would lose almost everything, and `beneficence` reads it at runtime through
  // `getResources`. Concatenate instead, exactly as the Soundness build does. Every fragment ends
  // with a newline, so the empty separator is correct.
  override def assemblyRules = super.assemblyRules ++ Seq(
    mill.javalib.Assembly.Rule.AppendPattern("META-INF/givens/.*"),
    mill.javalib.Assembly.Rule.AppendPattern("META-INF/services/.*"))

// Mixed into the library module that is released (`core`) — the module the `launcher` then pulls
// back in as a published coordinate. Releases go to GitHub Releases (see release.sh in
// propensive/.github), with `publishLocal` producing the jar and its POM; the Sonatype module is
// retained only for its POM machinery. Every setting mirrors the Soundness build: the same
// `dev.propensive` organization, Apache-2.0 licence, GitHub SCM and developer, plus the empty
// `-javadoc.jar`. The URL is lira's own distribution site, not soundness.dev.
trait Publishing extends Fork, SonatypeCentralPublishModule:
  // A `Task.Input` reading `Task.env`, not a plain value: `LIRA_RELEASE_VERSION` is how a release
  // and `make snapshot` (release.sh and snapshot.sh in propensive/.github) drive the version
  // through a Mill daemon that is already running — the daemon freezes `sys.env` at its own start,
  // while `Task.env` is the environment of each `./mill` invocation. Without it, the version is
  // `settings.nextVersion`. The launcher resolves these modules at this same version.
  def publishVersion = Task.Input:
    settings.version(Task.env)

  def artifactSuffix = Task("")

  def pomSettings = Task(PomSettings(
    description = "lira",
    organization = "dev.propensive",
    url = "https://lira.nexus/",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("propensive", "lira"),
    developers = Seq(Developer("propensive", "Jon Pretty", "https://github.com/propensive"))))

  override def docJar = Task:
    val jar = Task.dest / "empty.jar"
    val zos = new java.util.zip.ZipOutputStream(new java.io.FileOutputStream(jar.toIO))
    zos.close()
    PathRef(jar)

object lira extends Project:
  // The LIRA format: the language-blind implementation of the specification (`spec/lira.md`) —
  // blobs, trees, atoms, manifests, verification, buildpaths and the discipline SPI. Released, as
  // every module down to `core` is, in the one `dev.propensive:lira` jar (`library`, below). It and the five modules after it were Soundness's `reliquary`
  // and its `lira` adapter components until they moved here (Soundness roadmap item dist-10).
  object format extends Component(), Publishing:
    override def scalacOptions = settings.uncheckedOptions ++ settings.predef

    def mvnDeps = Task(Seq(
      mvn"dev.propensive:gastronomy-core:${deps.soundness()}",
      mvn"dev.propensive:pneumatic-brotli:${deps.soundness()}",
      mvn"dev.propensive:pneumatic-core:${deps.soundness()}",
      mvn"dev.propensive:revolution-semver:${deps.soundness()}",
      mvn"dev.propensive:stratiform-base256:${deps.soundness()}",
      mvn"dev.propensive:stratiform-core:${deps.soundness()}",
      mvn"dev.propensive:turbulence-async:${deps.soundness()}"))

  // Materialization: canonical derivative jars, the release assembler and classpaths from
  // releases.
  object derive extends Component(format), Publishing:
    override def scalacOptions = settings.uncheckedOptions ++ settings.predef

    def mvnDeps = Task(Seq(
      mvn"dev.propensive:galilei-jvm:${deps.soundness()}",
      mvn"dev.propensive:hellenism-jvm:${deps.soundness()}",
      mvn"dev.propensive:zeppelin-core:${deps.soundness()}"))

  // The `tasty/2` discipline over degustation's TASTy reader, which reads its inputs through
  // galilei's filesystem backend (the JVM one, `javaBaseFilesystem`, is in `galilei-jvm`).
  object tasty extends Component(format), Publishing:
    override def scalacOptions = settings.uncheckedOptions ++ settings.predef

    def mvnDeps = Task(Seq(
      mvn"dev.propensive:degustation-core:${deps.soundness()}",
      mvn"dev.propensive:galilei-jvm:${deps.soundness()}"))

  // The `classfile/1` and `jsig/1` disciplines, JVM profiles and host contracts over mandible.
  object classfile extends Component(format, derive), Publishing:
    def mvnDeps = Task(Seq(mvn"dev.propensive:mandible-core:${deps.soundness()}"))

  // The foreign-surface disciplines over xenophile's front ends: `dts/1`, `webidl/1`, `wit/1`,
  // `cheader/1` and `kotlin-metadata/1`.
  object foreign extends Component(format), Publishing:
    def mvnDeps = Task(Seq(
      mvn"dev.propensive:xenophile-cffi:${deps.soundness()}",
      mvn"dev.propensive:xenophile-kotlin:${deps.soundness()}",
      mvn"dev.propensive:xenophile-typescript:${deps.soundness()}",
      mvn"dev.propensive:xenophile-webidl:${deps.soundness()}",
      mvn"dev.propensive:xenophile-wit:${deps.soundness()}"))

  // `LiraBundle`: an anthology compilation's output as the input to a release.
  object bundle extends Component(format, derive), Publishing:
    override def scalacOptions = settings.uncheckedOptions ++ settings.predef
    def mvnDeps = Task(Seq(mvn"dev.propensive:anthology-core:${deps.soundness()}"))

  // The `lira` command-line tool (LIRA specification §5.1): the subcommands, the content-addressed
  // store and the renderings, over the format modules above.
  object core extends Component(format, derive, tasty, classfile), Publishing:
    def mvnDeps = Task(settings.soundnessDeps(deps.soundness()))

  // What is released: ONE jar, `dev.propensive:lira`, holding the classes of the seven modules
  // above. They stay separate modules because they compile under different options (`format`,
  // `derive`, `tasty` and `bundle` without capture checking), and each is still published locally,
  // as `lira-<module>`, only because Mill requires a publishing module's `moduleDeps` to publish;
  // none of those coordinates is released, and nothing should depend on one. This module has no
  // sources and no `moduleDeps`: its `compile` gathers the parts' classes, so its jar is their
  // union and a module depending on it compiles against them, and its POM names only the external
  // dependencies, which are the union of theirs.
  object library extends Component(), Publishing:
    override def artifactName = "lira"
    def parts: Seq[Component] = Seq(format, derive, tasty, classfile, foreign, bundle, core)
    override def sources = Task.Sources()

    def mvnDeps = Task:
      Task.traverse(parts)(_.mvnDeps)().flatten.distinct

    override def compile = Task:
      val classes = Task.dest / "classes"
      os.makeDir.all(classes)

      Task.traverse(parts)(_.localClasspath)().flatten.map(_.path).filter(os.isDir).foreach: root =>
        os.walk(root).filter(os.isFile).foreach: file =>
          val target = classes / file.relativeTo(root)
          if os.exists(target) then
            Task.fail(s"${file.relativeTo(root)} is in more than one part of the lira jar")
          os.copy(file, target, createFolders = true)

      mill.javalib.api.CompilationResult(Task.dest / "zinc", PathRef(classes))

  // The invocation point, ALONE in its own module (`src/launcher/lira_launcher.scala` — just the
  // `object lira` whose `main` is `externalize(LiraTool.run())`). It depends on the library NOT as a Mill `moduleDep`
  // but as a PUBLISHED coordinate, so coursier puts the byte-identical released jar on the compile
  // classpath that `externalize` hashes; the repackager then externalizes it into an on-demand
  // download instead of inlining. Burdock is also named explicitly because the `externalize` macro
  // and the `soundness.repackage` main are compiled and run against it.
  //
  // NOTE: `lira` resolves from `~/.ivy2/local`, so a `publishLocal` must precede this module's
  // assembly (`make run` and `make assembly` do so). Externalization happens only in a release,
  // once the same bytes are a GitHub release asset (a local copy alone would be inlined).
  //
  // `lira-tool` is here although the tool never calls it: release.sh refuses to publish an
  // executable unless every jar of the release externalizes from it, and it costs the executable
  // one more on-demand download.
  object launcher extends Component():
    def mvnDeps = Task:
      Seq(mvn"dev.propensive:lira:${library.publishVersion()}",
          mvn"dev.propensive:lira-tool:${tool.publishVersion()}")
        ++ settings.soundnessDeps(deps.soundness())

    def finalMainClass = "lira.lira"

    // A clean zip (no executable shell preamble) so the Burdock repackager can read and rewrite the
    // assembled JAR. This is also what the `.lira` interpreter directive needs: the executable is
    // built from this jar by xek, not by prepending a launcher script.
    def prependShellScript = ""

  // A `Suite` is not a main class (Soundness #1963): the beneficence plugin writes the
  // `META-INF/services/probably.Suite` index a host reads to discover suites, so the plugin must run
  // on this module or `fume run -c` finds nothing. `lira.runTests` is a plain-`java` entry point
  // that drives `Tests.invoke` in-process, for `make test-plain` and for CI's `test_main`.
  // One test module for the repository, since the shared CI workflow drives a single test
  // assembly.
  // The format modules' suites, moved from Soundness with them: `FormatTests` (formerly
  // reliquary's own) and the three adapter suites. Compiled, like the test suites in Soundness, without capture
  // checking; `test` below aggregates them into the repository's single test assembly.
  object `test-format` extends Component(library):
    override def scalacOptions = settings.uncheckedOptions ++ settings.predef
    def scalacPluginMvnDeps = Task(Seq(mvn"dev.propensive:beneficence-plugin:${deps.soundness()}"))

    def mvnDeps = Task(settings.testDeps(deps.soundness()) ++ Seq(
      mvn"dev.propensive:anthology-java:${deps.soundness()}",
      mvn"dev.propensive:anthology-scala:${deps.soundness()}",
      mvn"dev.propensive:enigmatic-core:${deps.soundness()}",
      mvn"dev.propensive:imperial-core:${deps.soundness()}",
      mvn"org.scala-lang:scala3-compiler_3:${settings.scalaVersion}",
      mvn"org.scala-lang:scala3-tasty-inspector_3:${settings.scalaVersion}"))

  object test extends Component(library):
    // `test-format` is not a `PublishModule`, so it cannot be a `Component` dependency; it joins
    // the assembly (and `runTests`'s classpath) through these instead.
    override def compileModuleDeps = Seq(`test-format`)
    override def runModuleDeps = Seq(`test-format`)

    def mvnDeps = Task(settings.testDeps(deps.soundness()))
    def scalacPluginMvnDeps = Task(Seq(mvn"dev.propensive:beneficence-plugin:${deps.soundness()}"))
    def finalMainClass = "lira.runTests"

  // The plugin contract (`src/tool`, package `lira.tool`; builds.md §14.3, fury.md §6): the
  // descriptor, invocation and outcome types a tool implements, built on anthology's forms.
  // Published as `dev.propensive:lira-tool`, the host contract both Fury (which loads tools
  // against it) and every tool, Fever first, compile against; each is in its own repository.
  object tool extends Component(library), Publishing:
    def mvnDeps = Task(settings.soundnessDeps(deps.soundness()) ++ settings.anthologyDeps(deps.soundness()))

// The release: the library module's jar, with its POM and ivy.xml embedded under
// `META-INF/maven/<group>/<artifactId>/`, named `<artifactId>-<version>.jar`, exactly as the
// Soundness build stages its own. A jar so staged is all a consumer needs: the shared sync script
// (propensive/.github) reconstructs the ivy2 layout coursier resolves from, which is how `make
// snapshot` publishes an unreleased build for a dependent repository to pin.
object release extends Module:
  def modules: Seq[PublishModule] =
    Seq(lira.library, lira.tool)

  private def withDescriptors(source: os.Path, target: os.Path, entries: Seq[(String, os.Path)])
  :   Unit =
    val input = new java.util.zip.ZipFile(source.toIO)
    val output = new java.util.zip.ZipOutputStream(new java.io.FileOutputStream(target.toIO))
    try
      val existing = input.entries()
      while existing.hasMoreElements do
        val entry = existing.nextElement()
        output.putNextEntry(new java.util.zip.ZipEntry(entry.getName))
        if !entry.isDirectory then input.getInputStream(entry).transferTo(output)
        output.closeEntry()

      for (name, file) <- entries do
        output.putNextEntry(new java.util.zip.ZipEntry(name))
        output.write(os.read.bytes(file))
        output.closeEntry()
    finally
      output.close()
      input.close()

  // The ivy.xml published beside each jar as `<artifactId>-<version>.ivy.xml`: the metadata
  // Coursier reads when crux (propensive/crux) uses the release as an Ivy-pattern repository,
  // without the sources and javadoc publications. Mill declares those in the `compile`
  // configuration too, and the crux artifact pattern names the main jar for any publication
  // without a classifier, so left in place they would resolve to the jar itself.
  private def stripDescriptor(ivy: String): String =
    val artifact = """<artifact\b[^>]*?(?:/>|>\s*</artifact>)""".r
    val filtered = artifact.replaceAllIn(ivy, found =>
      if found.matched.contains("classifier=") || found.matched.matches("""(?s).*\btype="(src|doc)".*""")
      then "" else java.util.regex.Matcher.quoteReplacement(found.matched))
    filtered.linesIterator.filter(_.trim.nonEmpty).mkString("", "\n", "\n")

  def stage: T[Seq[PathRef]] = Task:
    val jars: Seq[(PathRef, String, String, String, PathRef, PathRef)] =
      Task.traverse(modules)(module =>
        Task.Anon((module.jar(), module.pomSettings().organization, module.artifactId(),
                   module.publishVersion(), module.pom(), module.ivy())))()

    jars.flatMap: (jar, group, artifactId, version, pom, ivy) =>
      val target = Task.dest / s"$artifactId-$version.jar"
      val prefix = s"META-INF/maven/$group/$artifactId"
      val descriptors = Seq(s"$prefix/pom.xml" -> pom.path, s"$prefix/ivy.xml" -> ivy.path)
      withDescriptors(jar.path, target, descriptors)
      val metadata = Task.dest / s"$artifactId-$version.ivy.xml"
      os.write.over(metadata, stripDescriptor(os.read(ivy.path)))
      Seq(PathRef(target), PathRef(metadata))
